{
  "name": "aidoo",
  "version": "0.1.3",
  "description": "AI 작업과 할 일을 한눈에 보는 로컬 데스크톱 앱",
  "private": true,
  "license": "MIT",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "test": "tsx --test tests/*.test.ts",
    "start": "electron .",
    "package": "npm run build && electron-builder --mac dir",
    "smoke": "tsx scripts/smoke.ts"
  },
  "build": {
    "appId": "dev.aidoo.desktop",
    "productName": "Aidoo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "선택한 AI 세션을 Terminal에서 이어서 엽니다."
      },
      "icon": "assets/icon.png"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.325",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "author": "YoonShinWoong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoonShinWoong/aidoo.git"
  },
  "homepage": "https://github.com/YoonShinWoong/aidoo#readme",
  "bugs": {
    "url": "https://github.com/YoonShinWoong/aidoo/issues"
  }
}
